{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/media", "group/system", "group/session"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": [], "6": [], "7": []
    },
    "format": "{name}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 20,
    "icon": true,
    "icon-size": 15,
    "separate-outputs": true,
    "tooltip-format": "{title}",
    "rewrite": {
      "^(google-chrome|Google-chrome|chromium|Chromium)$": "Chrome",
      "^(firefox|firefox-esr|Firefox)$": "Firefox",
      "^(kitty|Kitty)$": "Kitty",
      "^(dolphin|org.kde.dolphin)$": "Dolphin",
      "^(nvim|Neovim)$": "Neovim",
      "^(code|Code|code-oss)$": "VS Code",
      "^(codium|VSCodium)$": "VSCodium",
      "^(okular|org.kde.okular)$": "Okular",
      "^(com.github.xournalpp.xournalpp|xournalpp)$": "Xournal++",
      "^(libreoffice-writer|soffice)$": "LibreOffice Writer",
      "^libreoffice-calc$": "LibreOffice Calc",
      "^libreoffice-impress$": "LibreOffice Impress",
      "^(org.kde.kate|kate)$": "Kate",
      "^(systemsettings|org.kde.systemsettings)$": "Ajustes de KDE",
      "^(pavucontrol|org.pulseaudio.pavucontrol)$": "Control de audio",
      "^(org.pwmt.zathura|zathura)$": "Zathura"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%A, %d de %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "mpris": {
    "format": "{dynamic}",
    "format-paused": "  {dynamic}",
    "max-length": 22,
    "dynamic-order": ["title", "artist"],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "custom/media": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Multimedia",
    "on-click": "playerctl play-pause"
  },
  "group/media": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250,
      "children-class": "media-details",
      "transition-left-to-right": false
    },
    "modules": ["custom/media", "mpris"]
  },
  "group/system": {
    "orientation": "inherit",
    "modules": ["network", "pulseaudio", "battery"]
  },
  "group/session": {
    "orientation": "inherit",
    "modules": ["tray", "custom/notifications", "custom/power"]
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫", "none": "󰂚",
      "dnd-notification": "󰂛", "dnd-none": "󰪓",
      "inhibited-notification": "󰂛", "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰪓"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  }
}
