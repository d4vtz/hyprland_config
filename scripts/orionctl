#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Uso: orionctl <comando>

Comandos:
  launcher       Abrir/cerrar lanzador
  dashboard      Abrir/cerrar dashboard
  control        Abrir/cerrar centro de control
  notifications Abrir notificaciones
  clipboard      Abrir portapapeles
  monitor        Abrir/cerrar monitor del sistema
  settings       Abrir/cerrar ajustes de Orion
  session        Abrir acciones de sesión
  close          Cerrar todos los paneles
  reload         Reiniciar Orion Shell
  status         Mostrar procesos de Quickshell
EOF
}

quickshell_is_running() {
    ps -C quickshell -o stat= 2>/dev/null | grep -qv '^[[:space:]]*Z'
}

dbus_name_is_owned() {
    busctl --user status "$1" >/dev/null 2>&1
}

wait_for_shutdown() {
    local attempt
    for attempt in {1..60}; do
        if ! quickshell_is_running \
            && ! dbus_name_is_owned org.freedesktop.Notifications \
            && ! dbus_name_is_owned org.kde.StatusNotifierWatcher; then
            return 0
        fi
        sleep 0.05
    done

    printf 'Advertencia: Quickshell no liberó completamente sus servicios D-Bus.\n' >&2
    return 1
}

cmd="${1:-}"
case "$cmd" in
    launcher)       exec qs ipc call launcher toggle ;;
    dashboard)      exec qs ipc call dashboard toggle ;;
    control)        exec qs ipc call controlcenter toggle ;;
    notifications)  exec qs ipc call activity notifications ;;
    clipboard)      exec qs ipc call activity clipboard ;;
    monitor)        exec qs ipc call monitor toggle ;;
    settings)       exec qs ipc call settings toggle ;;
    session)        exec qs ipc call session toggle ;;
    close)          exec qs ipc call panels closeAll ;;
    reload)
        qs kill || true
        wait_for_shutdown || true
        exec uwsm app -- qs
        ;;
    status)
        pgrep -af quickshell
        exec qs ipc show
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        printf 'Comando desconocido: %s\n\n' "$cmd" >&2
        usage >&2
        exit 2
        ;;
esac
